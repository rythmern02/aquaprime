# ── Sepolia deploy (root) ──────────────────────────────────────────────
# Deployer / router owner, without 0x prefix (hardhat config prepends it). Needs ≥ 0.15 Sepolia ETH.
PRIVATE_KEY=
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ETHERSCAN_API_KEY=

# Role separation (0x-prefixed). Unset → falls back to the deployer.
ATTESTER_PRIVATE_KEY=          # signs World ID HumanAttestations (same key goes into frontend/.env.local)
KEEPER_PRIVATE_KEY=            # executor operator; needs a little ETH for gas
TREASURY_ADDRESS=

# LP wallet that ships the 3 strategies (needs Sepolia USDC from faucet.circle.com + WETH + gas)
MAKER_PRIVATE_KEY=
SEED_USDC=20
SEED_AMM_WETH=0.05

# Optional overrides
# AQUA_ADDRESS=0x...           # reuse an already deployed official Aqua
# ORACLE_MODE=operator         # deploy a stress-test feed instead of Chainlink (enables the crash demo)
# INITIAL_ETH_PRICE_E8=250000000000
# Oracle freshness bound in seconds (default 7200 on live nets, 3600 local)
# MAX_PRICE_STALENESS=7200
