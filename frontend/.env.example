# ───────────── chain ─────────────
# 31337 = local hardhat node (default), 11155111 = Sepolia. Reads src/config/deployments/<id>.json
NEXT_PUBLIC_CHAIN_ID=31337
# Public RPC the browser reads from (routed through Anon-RPC unless it is a localhost URL)
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
# Server-side RPC (keeper / oracle operator). Defaults to NEXT_PUBLIC_RPC_URL
RPC_URL=

# ───────────── EF Anon-RPC ─────────────
# Worker specifier (adopters.json5). tor-js on mainnet by default; Nox (Sepolia) = 0x35133267A8F7EC35046a83DCA0f4Ca8A6e1b7A9A
NEXT_PUBLIC_ANON_SPECIFIER_ADDRESS=0x700dA3193D35fA54Cd3fBf29B66f2a2A0385659e
# Chain RPC used ONLY to read the specifier contract (bootstrap; specifier lives on mainnet for tor-js)
NEXT_PUBLIC_ANON_BOOTSTRAP_RPC=https://ethereum-rpc.publicnode.com
# Worker config passed verbatim (JSON). tor-js needs gateways; see anon-rpc adopters.json5
NEXT_PUBLIC_ANON_WORKER_CONFIG={"gateways":["152.236.3.22:12298:uEiCH0VdbhryzJcMtCfB0vLA4sOvHdQ4hq5w7CopcwU59bQ"]}

# ───────────── World IDKit (developer.world.org) ─────────────
NEXT_PUBLIC_WORLD_APP_ID=app_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_WORLD_ACTION=aquaprime-human-prime-tier
# production | staging (simulator.worldcoin.org) | sandbox
NEXT_PUBLIC_WORLD_ENVIRONMENT=staging
WORLD_RP_ID=rp_xxxxxxxxxxxxxxxx
WORLD_RP_SIGNING_KEY=0x...            # secret, server only
# Signs the on-chain HumanAttestation (must equal registry.humanAttester())
ATTESTER_PRIVATE_KEY=0x...

# ───────────── World ID Agent Pass (auth.world.org) ─────────────
WORLD_AUTH_ISSUER=https://auth.world.org          # sandbox: https://sandbox.auth.world.org
WORLD_AUTH_CLIENT_ID=
WORLD_AUTH_CLIENT_SECRET=                         # client_secret_post …
WORLD_AUTH_PRIVATE_KEY_JWK=                       # … or private_key_jwt (RS256 JWK JSON incl. "kid")
WORLD_AUTH_REDIRECT_URI=http://localhost:3000/api/agentpass/callback
# Accepted authentication classes (comma separated). Empty = accept any World account.
WORLD_AUTH_ACR_VALUES=https://world.org/oidc/acr/orb,https://world.org/oidc/acr/orb-face,https://world.org/oidc/acr/selfie,https://world.org/oidc/acr/selfie-face
# Approval lifetime in seconds
AGENT_APPROVAL_TTL=120

# ───────────── Keeper ─────────────
KEEPER_PRIVATE_KEY=0x...               # must be an operator on LiquidationExecutor
KEEPER_API_TOKEN=change-me             # shared secret for agent/keeper.ts -> /api/keeper/proposals
# Operator oracle (local / stress-test deployments only — never enabled against Chainlink)
ENABLE_OPERATOR_ORACLE=true
ORACLE_OPERATOR_PRIVATE_KEY=0x...      # owner of OperatorPriceFeed
# Local demo only: lets the UI fast-forward the hardhat clock past the 3-minute human grace window
ENABLE_DEV_TIME_TRAVEL=true
